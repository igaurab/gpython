#!/usr/bin/env bash
# Launch gpython. Usage: ./gpython [--no-vim] [notebook.py]
# With no file, opens an empty untitled notebook.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --project keeps your current directory, so relative notebook paths work.
exec uv run --quiet --project "$here" gpython "$@"
