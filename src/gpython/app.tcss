Screen {
    layers: base overlay;
}

#cells {
    width: 1fr;
    padding: 0 1;
}

#vars {
    width: 42;
    border-left: vkey $panel;
}

Cell {
    height: auto;
    margin-bottom: 1;
    border-left: thick $panel;
    padding-left: 1;
}

/* A class, not :focus-within, so a focus change restyles two cells, not the tree. */
Cell.-focused {
    border-left: thick $accent;
}

Cell.-error, Cell.-skipped {
    border-left: thick $error;
}

Cell.-stale {
    border-left: thick $warning;
}

Cell.-running, Cell.-queued {
    border-left: thick $primary;
}

/* Cell mode: the cell itself is selected (keys act on cells). After the status
   colours so the selection always shows. */
Cell.-selected {
    border-left: thick $accent;
}

Cell.-selected > .cell-header {
    text-style: reverse;
}

Cell.-collapsed OutputArea {
    max-height: 3;
}

.collapsed-note {
    height: 1;
    color: $text-muted;
    text-style: italic;
    padding: 0 1;
}

Cell TextArea {
    height: auto;
    max-height: 40;
    border: none;
    padding: 0;
}

Cell TextArea:focus {
    border: none;
}

.cell-header {
    height: 1;
}

.cell-output {
    display: none;
    height: auto;
    max-height: 40;
    overflow-y: auto;
    padding: 0 1;
    background: $boost;
}

.cell-output Static {
    height: auto;
}

.cell-output Image {
    height: 20;
    width: auto;
    margin: 1 0;
}

Prompt {
    align: center bottom;
    background: transparent;
}

#prompt {
    dock: bottom;
    height: 3;
    background: $surface;
    border-top: solid $accent;
}

#prompt Label {
    padding: 1 0 0 1;
    color: $accent;
    text-style: bold;
}

#prompt Input {
    border: none;
    height: 3;
    padding: 1 0 0 0;
    background: transparent;
}

#mode {
    dock: left;
    width: auto;
    height: 100%;
    padding: 0 1;
    content-align: center middle;
}

#status {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
}

HelpScreen {
    align: center middle;
}

#help {
    width: 90;
    max-width: 100%;
    height: 80%;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}
