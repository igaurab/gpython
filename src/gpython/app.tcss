#cells {
    width: 1fr;
    padding: 0 1;
}

#vars {
    width: 42;
    border-left: vkey $panel;
}

Cell {
    height: auto;
    margin-bottom: 1;
    border-left: thick $panel;
    padding-left: 1;
}

Cell:focus-within {
    border-left: thick $accent;
}

Cell.-error, Cell.-skipped {
    border-left: thick $error;
}

Cell.-stale {
    border-left: thick $warning;
}

Cell.-running, Cell.-queued {
    border-left: thick $primary;
}

Cell TextArea {
    height: auto;
    max-height: 30;
    border: none;
    padding: 0;
}

Cell TextArea:focus {
    border: none;
}

.cell-header {
    height: 1;
}

.cell-output {
    height: auto;
    max-height: 40;
    overflow-y: auto;
    padding: 0 1;
    background: $boost;
}
