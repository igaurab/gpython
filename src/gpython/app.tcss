Screen {
    layers: base overlay;
}

#body {
    height: 1fr;
}

/* Tabs (vim's tabline): shown only when there are two or more. */
#tabbar {
    display: none;
    height: 1;
    background: $panel;
    padding: 0 1;
}

GPython.-tabs #tabbar {
    display: block;
}

/* All notebook windows live here; windows.py places them. The background shows
   through the one-column gap between side-by-side windows. */
Workspace {
    width: 1fr;
    height: 1fr;
    background: $panel;
}

NotebookPane {
    background: $background;
}

.pane-body {
    height: 1fr;
}

/* vim's per-window status line: only when a tab has several windows. */
.pane-status {
    display: none;
    height: 1;
    background: $panel;
    color: $text-muted;
}

NotebookPane.-multi > .pane-status {
    display: block;
}

NotebookPane.-active > .pane-status {
    background: $primary 35%;
    color: $text;
}

#explorer {
    width: 34;
    max-width: 50%;
    height: 1fr;
    background: $surface;
    border-right: vkey $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#explorer:focus {
    border-right: vkey $accent;
}

#keycapture {
    dock: bottom;
    height: 1;
    width: auto;
    background: $panel;
}

KeyCapture {
    background: transparent;
    align: left bottom;
}

#cells {
    width: 1fr;
    padding: 0 1;
}

#vars {
    width: 42;
    max-width: 50%;
    border-left: vkey $panel;
}

/* The coloured bar at the left is an outline painted by Cell.paint_bar (status and
   focus colours), so focus changes never touch the CSS engine or the layout. */
Cell {
    height: auto;
    margin-bottom: 1;
    padding-left: 1;
    outline-left: thick $panel;
}

Cell.-collapsed OutputArea {
    max-height: 3;
}

.collapsed-note {
    height: 1;
    color: $text-muted;
    text-style: italic;
    padding: 0 1;
}

Cell TextArea {
    height: auto;
    max-height: 40;
    border: none;
    padding: 0;
}

Cell TextArea:focus {
    border: none;
}

.cell-header {
    height: 1;
}

.cell-output {
    display: none;
    height: auto;
    max-height: 40;
    overflow-y: auto;
    padding: 0 1;
    background: $boost;
}

.cell-output Static {
    height: auto;
}

.cell-output Image {
    height: 20;
    width: auto;
    margin: 1 0;
}

Prompt {
    align: center bottom;
    background: transparent;
}

#prompt {
    dock: bottom;
    height: 2;  /* the accent line + one line of text, no blank row */
    background: $surface;
    border-top: solid $accent;
}

#prompt Label {
    padding: 0 0 0 1;
    color: $accent;
    text-style: bold;
}

#prompt Input {
    border: none;
    height: 1;
    padding: 0;
    background: transparent;
}

ThemePicker {
    background: transparent;
}

#theme-picker {
    dock: bottom;
    height: 16;
    background: $surface;
    border-top: solid $accent;
}

#theme-picker Input {
    border: none;
    height: 1;
    padding: 0 1;
    background: transparent;
}

#theme-picker OptionList {
    border: none;
    height: 1fr;
    background: transparent;
}

EnvPicker {
    background: transparent;
}

#env-picker {
    dock: bottom;
    height: 20;
    background: $surface;
    border-top: solid $accent;
}

#env-picker.-ask {
    height: 6;
}

#env-title {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#env-picker Input {
    border: none;
    height: 1;
    padding: 0 1;
    background: transparent;
}

#env-picker OptionList {
    border: none;
    height: 1fr;
    background: transparent;
}

#kernel {
    dock: left;
    width: auto;
    height: 100%;
    padding: 0 1;
    content-align: center middle;
}

#mode-chip {
    dock: right;
    width: auto;
    height: 100%;
    content-align: center middle;
}

#kernel:hover {
    background: $accent 30%;
}

#status {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
}

HelpScreen {
    align: center middle;
}

#help {
    width: 90;
    max-width: 100%;
    height: 80%;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

/* Markdown cells: rendered text instead of the editor (see Cell.show_rendered). */
Cell.-markdown > MarkdownView {
    padding: 0 1 0 0;
}
